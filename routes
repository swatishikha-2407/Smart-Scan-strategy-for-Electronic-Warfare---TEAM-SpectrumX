"""
API routes for the Smart Scan Strategy backend.
"""

from typing import Dict

from fastapi import APIRouter, HTTPException
from pydantic import BaseModel

from .simulation_manager import SimulationManager


# ============================================================
# ROUTER
# ============================================================

router = APIRouter()


# ============================================================
# GLOBAL SIMULATION MANAGER
# ============================================================

simulation_manager = SimulationManager()


# ============================================================
# REQUEST MODELS
# ============================================================

class StartSimulationRequest(BaseModel):
    """
    Request body for starting a simulation.
    """

    scenario: str
    scheduler: str


# ============================================================
# VALID OPTIONS
# ============================================================

VALID_SCENARIOS = {
    "periodic",
    "random",
    "frequency_agile",
    "mixed",
    "unknown_activity",
}

VALID_SCHEDULERS = {
    "smart",
}


# ============================================================
# HEALTH
# ============================================================

@router.get("/health")
def health() -> Dict[str, str]:
    """
    Check whether the backend is running.
    """

    return {
        "status": "ok"
    }


# ============================================================
# START
# ============================================================

@router.post("/simulation/start")
def start_simulation(
    request: StartSimulationRequest
):
    """
    Start the simulation.

    Example request:

    {
        "scenario": "mixed",
        "scheduler": "smart"
    }
    """

    # Validate scenario
    if request.scenario not in VALID_SCENARIOS:
        raise HTTPException(
            status_code=400,
            detail={
                "error": "invalid scenario",
                "message": (
                    f"Invalid scenario '{request.scenario}'. "
                    f"Valid scenarios are: "
                    f"{sorted(VALID_SCENARIOS)}"
                ),
            },
        )

    # Validate scheduler
    if request.scheduler not in VALID_SCHEDULERS:
        raise HTTPException(
            status_code=400,
            detail={
                "error": "invalid scheduler",
                "message": (
                    f"Invalid scheduler '{request.scheduler}'. "
                    f"Valid schedulers are: "
                    f"{sorted(VALID_SCHEDULERS)}"
                ),
            },
        )

    try:
        return simulation_manager.start()

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail={
                "error": "simulation start failed",
                "message": str(exc),
            },
        )


# ============================================================
# STOP
# ============================================================

