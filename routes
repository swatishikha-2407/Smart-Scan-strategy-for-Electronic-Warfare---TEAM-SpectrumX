# ============================================================
# STEP
# ============================================================

@router.post("/simulation/step")
def simulation_step():
    """
    Perform one simulation cycle.
    """

    if not simulation_manager.running:
        raise HTTPException(
            status_code=400,
            detail={
                "error": "simulation not started",
                "message": (
                    "Start the simulation before calling /simulation/step."
                ),
            },
        )

    try:
        return simulation_manager.step()

    except RuntimeError as exc:
        raise HTTPException(
            status_code=400,
            detail={
                "error": "simulation error",
                "message": str(exc),
            },
        )

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail={
                "error": "simulation step failed",
                "message": str(exc),
            },
        )


# ============================================================
# SPECTRUM
# ============================================================

@router.get("/simulation/spectrum")
def get_spectrum():
    """
    Return the current state of all simulated frequency bands.

    This endpoint is intended for dashboard visualization.
    """

    current_time = simulation_manager.current_time

    # Obtain environment information if available.
    environment = simulation_manager.environment

    bands = []

    if environment is not None:

        environment_bands = getattr(
            environment,
            "bands",
            None
        )

        if environment_bands is not None:

            for band in environment_bands:

                if isinstance(band, dict):

                    band_number = band.get(
                        "band",
                        band.get("id", 0)
                    )

                    state = band.get(
                        "state",
                        "inactive"
                    )

                else:

                    band_number = getattr(
                        band,
                        "band",
                        getattr(band, "id", 0)
                    )

                    state = getattr(
                        band,
                        "state",
                        "inactive"
                    )

                bands.append({
                    "band": band_number,
                    "state": state,
                })

    # If Member 1 has not yet supplied band information,
    # return an empty list rather than inventing data.
    return {
        "time": current_time,
        "bands": bands,
    }


